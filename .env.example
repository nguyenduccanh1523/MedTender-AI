# Supabase dùng khi chạy app local. Thêm schema=medtender&sslmode=require&uselibpqcompat=true vào URL.
# Chỉ điền DATABASE_MIGRATION_URL nếu chạy migration từ máy.
DATABASE_MIGRATION_URL=
DATABASE_URL=
# PostgreSQL Docker chỉ dùng cho test cách ly tenant.
# TEST_DATABASE_MIGRATION_URL=postgresql://medtender_dev:medtender_local_only@127.0.0.1:55432/medtender
# TEST_DATABASE_URL=postgresql://medtender_app:medtender_app_local_only@127.0.0.1:55432/medtender

# Local development settings. Use a secret store in deployed environments.
API_PORT=3001
POSTGRES_PORT=55432
POSTGRES_DB=medtender
POSTGRES_USER=medtender_dev
POSTGRES_PASSWORD=medtender_local_only
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379/0
S3_PORT=59000
S3_BUCKET=medtender-local
S3_ENDPOINT=http://127.0.0.1:59000
EXTERNAL_AI_MODE=OFF

# Secret BE để ký JWT access token (64 ký tự hex).
AUTH_JWT_SECRET=

# URL public của FE, dùng để tạo link kích hoạt tài khoản.
APP_ORIGIN=http://127.0.0.1:3000

# LOG cho local; RESEND khi đã có domain gửi mail và API key.
EMAIL_DELIVERY_MODE=LOG
RESEND_API_KEY=
EMAIL_FROM="MedTender AI <no-reply@example.com>"

# Chỉ dùng với lệnh pnpm -C be admin:bootstrap.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_NAME=MedTender System Admin
SYSTEM_ADMIN_PASSWORD=
