  "info": {
    "title": "MedTender AI API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "medtender_access": {
        "type": "apiKey",
        "in": "cookie",
        "name": "medtender_access"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "api"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "service",
          "status"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "systemRole": {
            "type": "string",
            "enum": [
              "SYSTEM_ADMIN"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ActivateAccountDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "OrganizationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "BID_MANAGER",
              "ANALYST",
              "CATALOG_MANAGER",
              "REVIEWER",
              "VIEWER"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ]
      },
      "OrganizationMemberDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "BID_MANAGER",
              "ANALYST",
              "CATALOG_MANAGER",
              "REVIEWER",
              "VIEWER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          }
        },
        "required": [
          "userId",
          "name",
          "role",
          "status"
        ]
      },
      "InvitationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "BID_MANAGER",
              "ANALYST",
              "CATALOG_MANAGER",
              "REVIEWER",
              "VIEWER"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "expiresAt",
          "acceptedAt",
          "revokedAt"
        ]
      },
      "CreateInvitationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "BID_MANAGER",
              "ANALYST",
              "CATALOG_MANAGER",
              "REVIEWER",
              "VIEWER"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "CreatedInvitationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "BID_MANAGER",
              "ANALYST",
              "CATALOG_MANAGER",
              "REVIEWER",
              "VIEWER"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "expiresAt",
          "acceptedAt",
          "revokedAt",
          "token"
        ]
      },
      "AcceptInvitationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "token"
        ]
      },
      "CreateOrganizationApplicationDto": {
        "type": "object",
        "properties": {
          "organizationName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "taxCode": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "website": {
            "type": "string",
            "format": "uri",
            "maxLength": 240
          },
          "address": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "contactName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "contactPhone": {
            "type": "string",
            "minLength": 8,
            "maxLength": 30
          }
        },
        "required": [
          "organizationName",
          "taxCode",
          "address",
          "contactName",
          "contactEmail",
          "contactPhone"
        ]
      },
      "OrganizationApplicationReceiptDto": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING"
            ]
          }
        },
        "required": [
          "reference",
          "status"
        ]
      },
      "OrganizationApplicationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string"
          },
          "organizationName": {
            "type": "string"
          },
          "taxCode": {
            "type": "string"
          },
          "website": {
            "type": "object"
          },
          "address": {
            "type": "string"
          },
          "contactName": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "reference",
          "organizationName",
          "taxCode",
          "address",
          "contactName",
          "contactEmail",
          "contactPhone",
          "status",
          "createdAt"
        ]
      },
      "ApprovalResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "APPROVED"
            ]
          },
          "emailDelivery": {
            "type": "string",
            "enum": [
              "LOGGED",
              "SENT"
            ]
          },
          "activationLink": {
            "type": "string"
          },
          "organization": {
            "type": "object"
          }
        },
        "required": [
          "status",
          "emailDelivery",
          "organization"
        ]
      },
      "RejectApplicationDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
