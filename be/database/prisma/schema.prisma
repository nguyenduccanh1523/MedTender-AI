generator client {
  provider            = "prisma-client"
  output              = "../../api/src/database/generated"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("organization_status")
}

enum MembershipStatus {
  ACTIVE
  DISABLED

  @@map("membership_status")
}

enum MembershipRole {
  OWNER
  ADMIN
  BID_MANAGER
  ANALYST
  CATALOG_MANAGER
  REVIEWER
  VIEWER

  @@map("membership_role")
}

enum GlobalRole {
  SYSTEM_ADMIN

  @@map("global_role")
}

enum OrganizationApplicationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("organization_application_status")
}

enum ProcurementStage {
  RFQ
  FORMAL_TENDER
  INTERNAL

  @@map("procurement_stage")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum ProductVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED

  @@map("product_version_status")
}

enum DocumentType {
  TENDER_DOC
  CATALOG_EVIDENCE
  CERTIFICATE
  OTHER

  @@map("document_type")
}

enum FileScanStatus {
  PENDING
  SCANNING
  CLEAN
  QUARANTINED

  @@map("file_scan_status")
}

enum DocumentVersionStatus {
  DRAFT
  READY
  ARCHIVED

  @@map("document_version_status")
}

enum DataClassification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED

  @@map("data_classification")
}

model User {
  id           String                   @id @default(uuid()) @db.Uuid
  email        String                   @unique @db.Citext
  displayName  String                   @map("display_name")
  passwordHash String?                  @map("password_hash")
  authProvider String                   @default("local") @map("auth_provider")
  globalRole   GlobalRole?              @map("global_role")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships  OrganizationMembership[]
  sessions     AuthSession[]
  invitationsSent OrganizationInvitation[]
  activationTokens AccountActivationToken[]
  applicationsReviewed OrganizationApplication[] @relation("ApplicationReviewer")
  organizationsCreated Organization[] @relation("OrganizationCreator")
  tenderAudits TenderAuditLog[]
  productsCreated Product[] @relation("ProductCreator")
  productVersionsCreated ProductVersion[] @relation("ProductVersionCreator")
  productVersionsPublished ProductVersion[] @relation("ProductVersionPublisher")
  fileAssetsCreated FileAsset[] @relation("FileAssetCreator")
  documentsCreated Document[] @relation("DocumentCreator")
  documentVersionsCreated DocumentVersion[] @relation("DocumentVersionCreator")
  userPolicyConsents UserPolicyConsent[]
  securityIncidentsUploaded SecurityIncident[] @relation("IncidentUploader")
  securityIncidentsResolved SecurityIncident[] @relation("IncidentResolver")
  securityIncidentsPurged SecurityIncident[] @relation("IncidentPurger")

  @@map("users")
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  slug        String                   @unique
  name        String
  status      OrganizationStatus       @default(ACTIVE)
  settings    Json                     @default("{}")
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  application OrganizationApplication?
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdBy User? @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  tenders Tender[]
  tenderAudits TenderAuditLog[]
  products Product[]
  fileAssets FileAsset[]
  documents Document[]
  userPolicyConsents UserPolicyConsent[]
  securityIncidents SecurityIncident[]

  @@map("organizations")
}

model Tender {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  title String
  reference String?
  procurementStage ProcurementStage @map("procurement_stage")
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lots TenderLot[]
  documents Document[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt, id])
  @@map("tenders")
}

model TenderLot {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  tenderId String @map("tender_id") @db.Uuid
  code String @map("lot_code")
  name String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tender Tender @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  items TenderItem[]

  @@unique([tenderId, code])
  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@map("tender_lots")
}

model TenderItem {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  lotId String @map("lot_id") @db.Uuid
  itemNo String @map("item_no")
  name String
  quantity Decimal @db.Decimal(14, 3)
  unit String
  description String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lot TenderLot @relation(fields: [lotId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([lotId, itemNo])
  @@index([organizationId, lotId])
  @@map("tender_items")
}

model TenderAuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  tenderId       String?        @map("tender_id") @db.Uuid
  lotId          String?        @map("lot_id") @db.Uuid
  itemId         String?        @map("item_id") @db.Uuid
  actorUserId    String         @map("actor_user_id") @db.Uuid
  actorRole      MembershipRole @map("actor_role")
  action         String
  summary        String
  details        Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, tenderId, createdAt, id])
  @@map("tender_audit_logs")
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  sku             String           @db.Citext
  name            String
  brand           String
  manufacturer    String?
  category        String?
  status          ProductStatus    @default(ACTIVE)
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("ProductCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        ProductVersion[]
  documents       Document[]

  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt, id])
  @@map("products")
}

model ProductVersion {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  productId         String                 @map("product_id") @db.Uuid
  versionNumber     Int                    @map("version_number")
  versionLabel      String                 @map("version_label")
  modelCode         String                 @map("model_code")
  status            ProductVersionStatus   @default(DRAFT)
  fingerprint       String
  notes             String?
  publishedByUserId String?                @map("published_by_user_id") @db.Uuid
  publishedAt       DateTime?              @map("published_at") @db.Timestamptz(6)
  createdByUserId   String                 @map("created_by_user_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  product           Product                @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy         User                   @relation("ProductVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy       User?                  @relation("ProductVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  specifications    ProductSpecification[]

  @@unique([id, organizationId])
  @@unique([productId, versionNumber])
  @@unique([productId, versionLabel])
  @@index([organizationId, productId, versionNumber])
  @@map("product_versions")
}

model ProductSpecification {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  productVersionId  String         @map("product_version_id") @db.Uuid
  specKey           String         @map("spec_key")
  specValue         String         @map("spec_value")
  unit              String?
  sourceLabel       String         @map("source_label")
  sourceQuote       String?        @map("source_quote")
  documentVersionId String?        @map("document_version_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  productVersion    ProductVersion @relation(fields: [productVersionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId, organizationId], references: [id, organizationId], onDelete: SetNull)

  @@index([organizationId, productVersionId])
  @@map("product_specifications")
}

model FileAsset {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  bucket           String
  objectKey        String         @unique @map("object_key")
  originalFilename String         @map("original_filename")
  mimeType         String         @map("mime_type")
  sizeBytes        BigInt         @map("size_bytes")
  sha256           String
  scanStatus       FileScanStatus @default(PENDING) @map("scan_status")
  quarantineReason String?        @map("quarantine_reason")
  uploadTokenHash  String         @unique @map("upload_token_hash")
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdByUserId  String         @map("created_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy        User           @relation("FileAssetCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions         DocumentVersion[]
  incidents        SecurityIncident[]

  @@unique([id, organizationId])
  @@index([organizationId, scanStatus, createdAt])
  @@index([organizationId, sha256])
  @@map("file_assets")
}

model Document {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  title           String
  documentType    DocumentType       @default(TENDER_DOC) @map("document_type")
  classification  DataClassification @default(INTERNAL)
  description     String?
  tenderId        String?            @map("tender_id") @db.Uuid
  productId       String?            @map("product_id") @db.Uuid
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tender          Tender?            @relation(fields: [tenderId, organizationId], references: [id, organizationId], onDelete: SetNull)
  product         Product?           @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: SetNull)
  createdBy       User               @relation("DocumentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        DocumentVersion[]

  @@unique([id, organizationId])
  @@index([organizationId, tenderId])
  @@index([organizationId, productId])
  @@index([organizationId, createdAt, id])
  @@map("documents")
}

model DocumentVersion {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  documentId              String                @map("document_id") @db.Uuid
  versionNumber           Int                   @map("version_number")
  versionLabel            String                @map("version_label")
  fileAssetId             String                @map("file_asset_id") @db.Uuid
  status                  DocumentVersionStatus @default(DRAFT)
  rightsConfirmed         Boolean               @default(false) @map("rights_confirmed")
  rightsConfirmedAt       DateTime?             @map("rights_confirmed_at") @db.Timestamptz(6)
  acceptedTermsVersion    String?               @map("accepted_terms_version")
  acceptedPrivacyVersion  String?               @map("accepted_privacy_version")
  acceptedAiNoticeVersion String?               @map("accepted_ai_notice_version")
  notes                   String?
  createdByUserId         String                @map("created_by_user_id") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  document                Document              @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  fileAsset               FileAsset             @relation(fields: [fileAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy               User                  @relation("DocumentVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  specifications          ProductSpecification[]

  @@unique([id, organizationId])
  @@unique([documentId, versionNumber])
  @@unique([documentId, versionLabel])
  @@index([organizationId, documentId, versionNumber])
  @@map("document_versions")
}

model UserPolicyConsent {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  policyVersion    String       @map("policy_version")
  termsAccepted    Boolean      @default(true) @map("terms_accepted")
  privacyAccepted  Boolean      @default(true) @map("privacy_accepted")
  aiNoticeAccepted Boolean      @default(true) @map("ai_notice_accepted")
  acceptedAt       DateTime     @default(now()) @map("accepted_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, policyVersion])
  @@index([organizationId, userId])
  @@map("user_policy_consents")
}

model SecurityIncident {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  reference         String       @unique
  fileAssetId       String       @map("file_asset_id") @db.Uuid
  fileName          String       @map("file_name")
  sha256            String
  reason            String
  details           Json         @default("{}")
  status            String       @default("OPEN")
  ipAddress         String?      @map("ip_address")
  uploadedByUserId  String       @map("uploaded_by_user_id") @db.Uuid
  resolvedByUserId  String?      @map("resolved_by_user_id") @db.Uuid
  resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz(6)
  purgeReason       String?      @map("purge_reason")
  purgedByUserId    String?      @map("purged_by_user_id") @db.Uuid
  purgedAt          DateTime?    @map("purged_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fileAsset         FileAsset    @relation(fields: [fileAssetId, organizationId], references: [id, organizationId], onDelete: Cascade)
  uploadedBy        User         @relation("IncidentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  resolvedBy        User?        @relation("IncidentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  purgedBy          User?        @relation("IncidentPurger", fields: [purgedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@map("security_incidents")
}

model OrganizationApplication {
  id               String                         @id @default(uuid()) @db.Uuid
  reference        String                         @unique
  organizationName String                         @map("organization_name")
  taxCode          String                         @map("tax_code")
  website          String?
  address          String
  contactName      String                         @map("contact_name")
  contactEmail     String                         @map("contact_email") @db.Citext
  contactPhone     String                         @map("contact_phone")
  status           OrganizationApplicationStatus @default(PENDING)
  reviewedByUserId String?                        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?                      @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason  String?                        @map("rejection_reason")
  organizationId   String?                        @unique @map("organization_id") @db.Uuid
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  reviewedBy       User?                          @relation("ApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  organization     Organization?                  @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([contactEmail, status])
  @@map("organization_applications")
}

model AccountActivationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("account_activation_tokens")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_memberships")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model OrganizationInvitation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  email          String
  role           MembershipRole
  tokenHash      String         @unique @map("token_hash")
  invitedBy      String?        @map("invited_by") @db.Uuid
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?      @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User?          @relation(fields: [invitedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("organization_invitations")
}
