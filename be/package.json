{
  "name": "@medtender/be",
  "private": true,
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@types/jest": "^29",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "@types/supertest": "^6",
    "eslint": "^9",
    "jest": "^29",
    "openapi-typescript": "^7",
    "prisma": "7.10.1",
    "supertest": "^7",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "scripts": {
    "dev": "pnpm dev:api",
    "dev:fe": "pnpm -C ../fe dev",
    "dev:api": "cd api && node --watch --env-file-if-exists=../../.env -r ts-node/register src/main.ts",
    "dev:worker": "cd worker && node --watch --env-file-if-exists=../../.env -r ts-node/register src/main.ts",
    "dev:ai": "cd ../ai && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "start:api": "cd api && node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "cd worker && node --env-file-if-exists=../../.env dist/main.js",
    "test": "pnpm test:api && pnpm test:worker && pnpm -C ../fe test && pnpm test:ai",
    "test:api": "cd api && jest --runInBand",
    "test:worker": "cd worker && jest --runInBand",
    "test:ai": "cd ../ai && .venv/bin/python -m pytest",
    "test:db": "cd api && node --experimental-vm-modules --env-file=../../.env ../node_modules/jest/bin/jest.js --runInBand --testMatch \"**/test/integration/*.test.ts\"",
    "test:redis": "cd worker && node --env-file-if-exists=../../.env ../node_modules/jest/bin/jest.js --runInBand --testMatch \"**/test/integration/*.test.ts\"",
    "lint": "eslint api/src api/test worker/src worker/test && pnpm -C ../fe lint && pnpm lint:ai",
    "lint:ai": "cd ../ai && .venv/bin/ruff check .",
    "typecheck": "tsc --noEmit -p api/tsconfig.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit --strict contracts/src/api.d.ts && pnpm -C ../fe typecheck",
    "build": "tsc -p api/tsconfig.build.json && tsc -p worker/tsconfig.build.json && pnpm -C ../fe build",
    "contracts:generate": "cd api && ts-node src/openapi.ts && cd ../contracts && openapi-typescript openapi.json -o src/api.d.ts",
    "db:validate": "cd database && prisma validate",
    "db:deploy": "cd database && prisma migrate deploy",
    "db:generate": "cd database && prisma generate",
    "db:check": "cd api && node --env-file-if-exists=../../.env -r ts-node/register src/database/check.ts",
    "db:status": "cd database && prisma migrate status",
    "db:local-role": "docker compose --env-file ../.env -f infra/compose.dev.yaml exec -T postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\" -v ON_ERROR_STOP=1' < infra/local-runtime-role.sql",
    "infra:up": "docker compose --env-file ../.env -f infra/compose.dev.yaml up -d --wait",
    "infra:down": "docker compose --env-file ../.env -f infra/compose.dev.yaml --profile db-test down",
    "infra:test-db:up": "docker compose --env-file ../.env -f infra/compose.dev.yaml up -d --wait postgres",
    "db:test:deploy": "cd database && MEDTENDER_TEST_DATABASE=1 prisma migrate deploy",
    "admin:bootstrap": "cd api && node --env-file=../../.env -r ts-node/register src/scripts/bootstrap-system-admin.ts",
    "demo:seed": "cd api && node --env-file=../../.env -r ts-node/register src/scripts/demo-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5",
    "ioredis": "^5",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  }
}
